# Database
#  - Lokal  : biarkan default (file SQLite di folder data/)
#  - Online : URL Turso, contoh libsql://minimarket-namaanda.turso.io
DATABASE_URL=file:./data/minimarket.db
# Token Turso (kosongkan bila memakai file lokal)
DATABASE_AUTH_TOKEN=

# Secret untuk menandatangani session login (WAJIB diganti di production, min. 32 karakter acak)
# Buat dengan: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia
